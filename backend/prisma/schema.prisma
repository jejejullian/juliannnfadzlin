// ============================================================
// PRISMA SCHEMA - Portfolio Backend
// ============================================================
// SUPABASE INTEGRATION POINT:
//   - Isi DATABASE_URL dan DIRECT_URL di file .env
//   - Ambil dari: Supabase Dashboard > Project Settings > Database > Connection String
//   - Pilih mode "Transaction" untuk DIRECT_URL
//   - Pilih mode "Session" / "Node.js" untuk DATABASE_URL
// ============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // ⚠️ SUPABASE STEP 1: Ganti value di .env
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String
  tech_stack  String   // Format string CSV: "React, Node.js, PostgreSQL"
  image_url   String   // URL publik dari Supabase Storage
  live_link   String?  // Optional - link demo live
  github_link String?  // Optional - link repo github
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
