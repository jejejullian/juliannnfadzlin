# GitHub Personal Access Token
# Required scopes: read:user, public_repo
#
# Steps to create:
# 1. Go to https://github.com/settings/tokens/new
# 2. Select scopes: read:user, public_repo
# 3. Copy the generated token
# 4. In Vercel Dashboard → Project → Settings → Environment Variables:
#    Add: GITHUB_TOKEN = ghp_xxxxxxxxxxxx (for Production + Preview + Development)
#
# For local dev with `vercel dev`:
# Create a .env.local file (already gitignored) with:
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx

GITHUB_TOKEN=
